# ---------------------------------------------
# ShopDeck Environment Configuration
# ---------------------------------------------

# Backend Server Port (default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# Database Persistence (set to 'false' for in-memory / no-cache mode)
USE_DATABASE=true

# Database Path (defaults to server/products.db for local SQLite)
DB_PATH=./server/products.db

# ---------------------------------------------
# Lifetime Free Cloud Database (Turso / LibSQL)
# Solves Render ephemeral disk: data never wipes on restart
# Get 9GB free at https://turso.tech
# ---------------------------------------------
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-jwt-token

# Initial Admin Password (default: admin)
ADMIN_DEFAULT_PASSWORD=admin

# Production CORS Whitelist (comma-separated origins)
# CORS_ORIGIN=https://shop-deck.netlify.app

# Client API URL for production builds
# VITE_API_URL=https://shopdeck-api.onrender.com

# ---------------------------------------------
# Social Login Options (Google & GitHub)
# ---------------------------------------------
# Google OAuth 2.0 (Get from https://console.cloud.google.com/apis/credentials)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth App (Get from https://github.com/settings/developers)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
