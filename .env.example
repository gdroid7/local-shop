# ---------------------------------------------
# ShopDeck Environment Configuration
# ---------------------------------------------

# Backend Server Port (default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# SQLite Persistence (set to 'false' for in-memory / no-cache mode)
USE_DATABASE=true

# Database Path (defaults to server/products.db)
DB_PATH=./server/products.db

# Initial Admin Password (default: admin)
ADMIN_DEFAULT_PASSWORD=admin

# Client API Proxy URL (optional, defaults to http://localhost:3000)
# VITE_API_URL=http://localhost:3000
