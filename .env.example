# ---------------------------------------------
# ShopDeck Environment Configuration
# ---------------------------------------------

# Backend Server Port (default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# SQLite Persistence (set to 'false' for in-memory / no-cache mode)
USE_DATABASE=true

# Database Path (defaults to server/products.db)
DB_PATH=./server/products.db

# Initial Admin Password (default: admin)
ADMIN_DEFAULT_PASSWORD=admin

# Production CORS Whitelist (comma-separated origins, e.g. https://shopdeck.netlify.app)
# CORS_ORIGIN=https://shopdeck.netlify.app

# Client API URL for production builds
# VITE_API_URL=https://shopdeck-api.onrender.com
