{
  "name": "shopdeck",
  "version": "1.0.0",
  "description": "Minimalist universal product visualizer, link parser, and swipeable shopping deck.",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && cd server && npm install && cd ../client && npm install",
    "install:all": "npm run setup",
    "dev": "concurrently --names 'api,web,tunnel' -c 'cyan,magenta,yellow' \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:ngrok\"",
    "dev:local": "concurrently --names 'api,web' -c 'cyan,magenta' \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:ngrok": "node scripts/start-ngrok.js",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "start:prod": "npm run build && node server/index.js",
    "test": "cd server && npm test",
    "deploy:check": "node scripts/deploy-preflight.js",
    "outreach": "node scripts/outreach-generator.js && open outreach/index.html"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gdroid7/shopDeck.git"
  },
  "keywords": [
    "shopping",
    "wishlist",
    "scraper",
    "tinder-ui",
    "swipe",
    "react",
    "express",
    "sqlite"
  ],
  "author": "gdroid7",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "puppeteer-core": "^25.17.0"
  }
}
